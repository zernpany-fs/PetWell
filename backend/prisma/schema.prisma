generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CLINIC_STAFF
}

enum RecordType {
  VACCINE
  TREATMENT
}

enum ClinicType {
  GENERAL
  EXOTIC
  EMERGENCY_24HR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AccessType {
  APPOINTMENT
  OWNER_SHARE
}

enum GrantEndReason {
  REVOKED
  CANCELLED
  REJECTED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  email       String   @unique
  password    String
  avatarUrl   String?  @map("avatar_url")
  coverUrl    String?  @map("cover_url")
  addressLine String?  @map("address_line")
  subdistrict String?
  district    String?
  province    String?
  postalCode  String?  @map("postal_code") @db.VarChar(5)
  role        Role
  clinicId    String?  @map("clinic_id") @db.Uuid
  clinic      Clinic?  @relation("ClinicStaff", fields: [clinicId], references: [id])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  pets              Pet[]
  createdRecords    HealthRecord[]         @relation("RecordAuthor")
  statusChanges     AppointmentStatusLog[]
  accessLogs        PetAccessLog[]
  shareCodeAttempts ShareCodeAttempt[]

  @@map("users")
}

model Pet {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  owner            User      @relation(fields: [ownerId], references: [id])
  name             String
  species          String
  breed            String?
  birthDate        DateTime? @map("birth_date") @db.Date
  photoUrl         String?   @map("photo_url")
  chronicCondition String?   @map("chronic_condition")
  drugAllergy      String?   @map("drug_allergy")
  microchipNo      String?   @map("microchip_no")
  latestWeight     Float?    @map("latest_weight")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  healthRecords HealthRecord[]
  appointments  Appointment[]
  accessGrants  PetAccessGrant[]
  shareCodes    ShareCode[]
  accessLogs    PetAccessLog[]

  @@map("pets")
}

model HealthRecord {
  id            String       @id @default(uuid()) @db.Uuid
  petId         String       @map("pet_id") @db.Uuid
  pet           Pet          @relation(fields: [petId], references: [id])
  clinicId      String       @map("clinic_id") @db.Uuid
  clinic        Clinic       @relation(fields: [clinicId], references: [id])
  createdById   String       @map("created_by") @db.Uuid
  createdBy     User         @relation("RecordAuthor", fields: [createdById], references: [id])
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  recordType    RecordType   @map("record_type")
  description   String
  recordDate    DateTime     @map("record_date") @db.Date
  nextDueDate   DateTime?    @map("next_due_date") @db.Date
  attachments   String[]     @default([])
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("health_records")
}

model Clinic {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  address        String?
  phone          String?
  description    String?
  photoUrl       String?    @map("photo_url")
  clinicType     ClinicType @map("clinic_type")
  googleMapsLink String?    @map("google_maps_link")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  staff             User[]             @relation("ClinicStaff")
  healthRecords     HealthRecord[]
  appointments      Appointment[]
  accessGrants      PetAccessGrant[]
  accessLogs        PetAccessLog[]
  shareCodeAttempts ShareCodeAttempt[]

  @@map("clinics")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  petId           String            @map("pet_id") @db.Uuid
  pet             Pet               @relation(fields: [petId], references: [id])
  clinicId        String            @map("clinic_id") @db.Uuid
  clinic          Clinic            @relation(fields: [clinicId], references: [id])
  appointmentDate DateTime          @map("appointment_date") @db.Timestamptz()
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  statusLogs    AppointmentStatusLog[]
  healthRecords HealthRecord[]
  accessGrant   PetAccessGrant?

  @@index([clinicId, appointmentDate])
  @@map("appointments")
}

model AppointmentStatusLog {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])
  changedById   String             @map("changed_by") @db.Uuid
  changedBy     User               @relation(fields: [changedById], references: [id])
  oldStatus     AppointmentStatus? @map("old_status")
  newStatus     AppointmentStatus  @map("new_status")
  reason        String?
  changedAt     DateTime           @default(now()) @map("changed_at") @db.Timestamptz()

  @@map("appointment_status_logs")
}

// ---------- V2: consent-based access (D17, D23–D27) ----------

model PetAccessGrant {
  id            String          @id @default(uuid()) @db.Uuid
  type          AccessType
  petId         String          @map("pet_id") @db.Uuid
  pet           Pet             @relation(fields: [petId], references: [id])
  clinicId      String          @map("clinic_id") @db.Uuid
  clinic        Clinic          @relation(fields: [clinicId], references: [id])
  appointmentId String?         @unique @map("appointment_id") @db.Uuid
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  shareCodeId   String?         @unique @map("share_code_id") @db.Uuid
  shareCode     ShareCode?      @relation(fields: [shareCodeId], references: [id])
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz()
  endedAt       DateTime?       @map("ended_at") @db.Timestamptz()
  endReason     GrantEndReason? @map("end_reason")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  accessLogs PetAccessLog[]

  @@index([petId, clinicId])
  @@map("pet_access_grants")
}

model ShareCode {
  id           String    @id @default(uuid()) @db.Uuid
  petId        String    @map("pet_id") @db.Uuid
  pet          Pet       @relation(fields: [petId], references: [id])
  codeHash     String    @map("code_hash")
  durationDays Int?      @map("duration_days")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  usedAt       DateTime? @map("used_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  grant PetAccessGrant?

  @@index([codeHash])
  @@map("share_codes")
}

model PetAccessLog {
  id       String          @id @default(uuid()) @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  user     User            @relation(fields: [userId], references: [id])
  clinicId String          @map("clinic_id") @db.Uuid
  clinic   Clinic          @relation(fields: [clinicId], references: [id])
  petId    String          @map("pet_id") @db.Uuid
  pet      Pet             @relation(fields: [petId], references: [id])
  grantId  String?         @map("grant_id") @db.Uuid
  grant    PetAccessGrant? @relation(fields: [grantId], references: [id])
  viewedAt DateTime        @default(now()) @map("viewed_at") @db.Timestamptz()

  @@map("pet_access_logs")
}

model ShareCodeAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  clinicId    String   @map("clinic_id") @db.Uuid
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  success     Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz()

  @@index([userId, attemptedAt])
  @@index([clinicId, attemptedAt])
  @@map("share_code_attempts")
}
