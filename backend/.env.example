# ── Server ────────────────────────────────────────────────────────────────
PORT="8000"
# Allowed CORS origin (the Next.js app). Optional; defaults to localhost:3000.
FRONTEND_URL="http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgres://postgres:postgres@localhost:5432/PetWell_Project"

# ── Auth ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=""
# Access token lifetime, in seconds (86400 = 24h).
ACCESS_TOKEN_EXPIRES_IN="86400"

# ── Cloudinary (pet photos, record attachments, avatars) ──────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# HMAC secret for share codes (D26), at least 32 chars
SHARE_CODE_SECRET=
