<mxfile host="app.diagrams.net" agent="PetWell" version="24.0.0">
  <diagram id="petwell-appt-grant-flow" name="Appointment → Grant">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="&lt;b&gt;Appointment A changes status&lt;/b&gt;&lt;br&gt;clinic updateStatus · owner cancel · owner archives pet&lt;br&gt;all inside one $transaction" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DCE6F5;strokeColor=#2E5FA3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="23" width="470" height="74" as="geometry"/></mxCell>
        <mxCell id="d0" value="&lt;b&gt;New status?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="142" width="200" height="96" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Grant G for A&lt;/b&gt;&lt;br&gt;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="295" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Create G&lt;/b&gt;&lt;br&gt;type = APPOINTMENT&lt;br&gt;expires_at = null&lt;br&gt;D1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DDF0E4;strokeColor=#1F6B42;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;No change&lt;/b&gt;&lt;br&gt;no duplicate,&lt;br&gt;revoked stays ended&lt;br&gt;US-01 AC3, D13" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;No change&lt;/b&gt;&lt;br&gt;G keeps its state&lt;br&gt;US-01 AC3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="454" width="160" height="92" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;G exists and&lt;/b&gt;&lt;br&gt;is active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="295" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Set expiry&lt;/b&gt;&lt;br&gt;expires_at =&lt;br&gt;now + 30 days&lt;br&gt;D2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DDF0E4;strokeColor=#1F6B42;fontSize=11;" vertex="1" parent="1"><mxGeometry x="675" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;No change&lt;/b&gt;&lt;br&gt;no G (v1 data) or&lt;br&gt;ended G stays ended&lt;br&gt;D23, D28" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="825" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;G exists and&lt;/b&gt;&lt;br&gt;is active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#B7791F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="295" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;End G&lt;/b&gt;&lt;br&gt;ended_at = now&lt;br&gt;end_reason =&lt;br&gt;new status · D4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DDF0E4;strokeColor=#1F6B42;fontSize=11;" vertex="1" parent="1"><mxGeometry x="995" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;No change&lt;/b&gt;&lt;br&gt;keeps REVOKED&lt;br&gt;if revoked before&lt;br&gt;D12" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1145" y="454" width="140" height="92" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;Commit: status change, status log and grant change&lt;/b&gt;&lt;br&gt;succeed or fail together" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DCE6F5;strokeColor=#2E5FA3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="658" width="520" height="64" as="geometry"/></mxCell>
