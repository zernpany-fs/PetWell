        <mxCell id="f1" value="CONFIRMED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="RESCHEDULED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d0" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="COMPLETED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d0" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="REJECTED / CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d0" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d1" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d3" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d3" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d4" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="d4" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="a1" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
