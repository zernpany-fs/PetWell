        <mxCell id="f13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="n2" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="a3" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="n3" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="a4" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;fontColor=#B7791F;" edge="1" parent="1" source="n4" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="PetWell V2 · Appointment status → access grant · green = grant changes · grey = no change · amber = decision&lt;br&gt;G = the grant whose appointment_id = A (unique, D17). Active = ended_at IS NULL AND (expires_at IS NULL OR expires_at &amp;gt; now). Expiry needs no job: it is checked on every read.&lt;br&gt;Not in this chart (owner actions, not appointment status): share-code redeem (US-03), revoke (US-04 AC1–AC3), extend (US-04 AC4)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1240" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
