{
  "info": {
    "name": "Petwell V2 – Share codes",
    "description": "V2 consent-based access: share code, redeem, list, extend, revoke. Run top to bottom with the backend on http://localhost:8000 and a seeded database. Test accounts only (seed password from the README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Owner login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run Register (in the Petwell collection) first if this owner does not exist yet.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('ownerToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create pet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PostmanPet\",\n  \"species\": \"Dog\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('petId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff login (vet2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staffToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Share code flow",
      "item": [
        {
          "name": "1. Generate share code (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/share-codes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "{{petId}}",
                "share-codes"
              ]
            },
            "description": "US-03 AC1. durationDays: 7, 30, 90 or null (unlimited) — D41. The code is valid 15 minutes and works once (D7).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationDays\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('shareCode', pm.response.json().code);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Redeem share code (staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/share-codes/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "share-codes",
                "redeem"
              ]
            },
            "description": "US-03 AC2. Wrong, expired or used code → 400 'Invalid or expired code'; too many wrong codes → 429 with minutes left (D40, D42). Sending it twice shows the 400.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{shareCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('grantId', pm.response.json().grantId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. List access grants (owner)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/access-grants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "{{petId}}",
                "access-grants"
              ]
            },
            "description": "US-04. Active grants only, newest first (D43). Saves the first grant's clinic id for the revoke request.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const g = pm.response.json();",
                  "if (g.length) { pm.collectionVariables.set('clinicId', g[0].clinic.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Extend share grant (owner)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/access-grants/{{grantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "access-grants",
                "{{grantId}}"
              ]
            },
            "description": "US-04 AC4. New duration counted from now (D27). Appointment grants or ended grants → 409 (D44).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationDays\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Revoke clinic access (owner)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/clinics/{{clinicId}}/access",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pets",
                "{{petId}}",
                "clinics",
                "{{clinicId}}",
                "access"
              ]
            },
            "description": "US-04 AC1–AC2. Ends every active grant of that clinic; does not cancel appointments (D12). No active access → 404 (D44).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "ownerEmail",
      "value": "owner1@test.com"
    },
    {
      "key": "staffEmail",
      "value": "vet2@test.com"
    },
    {
      "key": "password",
      "value": "pass123"
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    },
    {
      "key": "shareCode",
      "value": ""
    },
    {
      "key": "grantId",
      "value": ""
    },
    {
      "key": "clinicId",
      "value": ""
    }
  ]
}