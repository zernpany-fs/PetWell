{
  "info": {
    "name": "Petwell – Core flow",
    "description": "Register, log in, create a pet, book, confirm and cancel an appointment, and check the clinic's access before and after. Run top to bottom with the backend on http://localhost:8000 and a seeded database. Test accounts only (seed password from the README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Creates the owner the first time. Running it again returns 409, which is fine.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Owner\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201, or 409 if the owner already exists', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Owner login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('ownerToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create pet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pets"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"PostmanPet\",\n  \"species\": \"Dog\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('petId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Staff login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Saves the staff member's clinic id, so the appointment is booked at that clinic.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const u = pm.response.json();",
              "pm.collectionVariables.set('staffToken', u.access_token);",
              "pm.collectionVariables.set('clinicId', u.user.clinicId);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Book appointment (owner)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"clinicId\": \"{{clinicId}}\",\n  \"appointmentDate\": \"{{appointmentDate}}\",\n  \"notes\": \"Booked from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A random future weekday slot inside opening hours (09:00–17:00 start, Bangkok time),",
              "// so repeated runs do not hit the limit of 2 appointments per clinic per hour.",
              "const d = new Date(Date.now() + (2 + Math.floor(Math.random() * 60)) * 86400000);",
              "while ([0, 6].includes(d.getUTCDay())) d.setUTCDate(d.getUTCDate() + 1);",
              "const hour = 9 + Math.floor(Math.random() * 9);",
              "const ymd = d.toISOString().slice(0, 10);",
              "pm.collectionVariables.set('appointmentDate', `${ymd}T${String(hour).padStart(2, '0')}:00:00+07:00`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('appointmentId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Confirm appointment (staff)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}",
            "status"
          ]
        },
        "description": "First CONFIRMED gives the clinic access to the pet (V2, D1).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{staffToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Open pet (staff)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pets/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pets",
            "{{petId}}"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{staffToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('FULL access', () => pm.expect(pm.response.json().accessLevel).to.eql('FULL'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Cancel appointment (owner)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/appointments/{{appointmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "appointments",
            "{{appointmentId}}"
          ]
        },
        "description": "Ends the access the appointment gave (V2, D4).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Open pet again (staff)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pets/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pets",
            "{{petId}}"
          ]
        },
        "description": "No access and no records written by this clinic → 404 (D20).",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{staffToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "ownerEmail",
      "value": "owner1@test.com"
    },
    {
      "key": "staffEmail",
      "value": "vet1@test.com"
    },
    {
      "key": "password",
      "value": "pass123"
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    },
    {
      "key": "clinicId",
      "value": ""
    },
    {
      "key": "appointmentDate",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ]
}